{
  "name": "vibevideo",
  "displayName": "VibeVideo",
  "description": "Vibe Video: Create videos like writing code — write your script in Markdown, and AI automatically generates storyboards and edits the footage.",
  "version": "0.0.1",
  "publisher": "fastpen",
  "engines": {
    "vscode": "^1.106.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cici2014/vibevideo.git"
  },
  "homepage": "https://github.com/Cici2014/vibevideo",
  "bugs": {
    "url": "https://github.com/Cici2014/vibevideo/issues"
  },
  "license": "MIT",
  "keywords": [
    "video",
    "ai",
    "markdown",
    "storyboard",
    "video-editing",
    "ai-video",
    "video-generation",
    "通义万相",
    "tongyi-wanxiang"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibevideo.initProject",
        "title": "Vibe Video: Initialize Project",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.checkStoryboards",
        "title": "Vibe Video: Check Storyboards Quality",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.refreshResources",
        "title": "Vibe Video: Refresh Resources",
        "category": "Vibe Video",
        "icon": "$(refresh)"
      },
      {
        "command": "vibevideo.showStats",
        "title": "Vibe Video: Show Project Stats",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.configureAPI",
        "title": "Vibe Video: Configure Video AI",
        "category": "Vibe Video",
        "icon": "$(gear)"
      },
      {
        "command": "vibevideo.showConfig",
        "title": "Vibe Video: Show Current Config",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.generateFirstFrames",
        "title": "Vibe Video: Generate First Frames",
        "category": "Vibe Video",
        "icon": "$(file-media)"
      },
      {
        "command": "vibevideo.generateVideos",
        "title": "Vibe Video: Generate All Videos",
        "category": "Vibe Video",
        "icon": "$(play)"
      },
      {
        "command": "vibevideo.generateSingleVideo",
        "title": "生成视频",
        "category": "Vibe Video",
        "icon": "$(play)"
      },
      {
        "command": "vibevideo.generateSubjects",
        "title": "Vibe Video: Generate All Subjects",
        "category": "Vibe Video",
        "icon": "$(account)"
      },
      {
        "command": "vibevideo.generateSingleSubject",
        "title": "生成主体",
        "category": "Vibe Video",
        "icon": "$(account)"
      },
      {
        "command": "vibevideo.generateScenes",
        "title": "Vibe Video: Generate All Scenes",
        "category": "Vibe Video",
        "icon": "$(symbol-color)"
      },
      {
        "command": "vibevideo.generateSingleScene",
        "title": "生成场景",
        "category": "Vibe Video",
        "icon": "$(symbol-color)"
      },
      {
        "command": "vibevideo.composeFirstFrames",
        "title": "Vibe Video: Compose All First Frames",
        "category": "Vibe Video",
        "icon": "$(combine)"
      },
      {
        "command": "vibevideo.composeStoryboardFirstFrame",
        "title": "Vibe Video: Compose First Frame",
        "category": "Vibe Video",
        "icon": "$(file-media)"
      },
      {
        "command": "vibevideo.openFirstFrameResource",
        "title": "Vibe Video: Open First Frame Resource",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.addReferenceImage",
        "title": "添加参考图",
        "category": "Vibe Video",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibe-video",
          "title": "Vibe Video",
          "icon": "$(device-camera-video)"
        }
      ]
    },
    "views": {
      "vibe-video": [
        {
          "id": "vvResources",
          "name": "项目资源"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vibevideo.refreshResources",
          "when": "view == vvResources",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vibevideo.generateFirstFrames",
          "when": "view == vvResources && viewItem == firstFramesRoot",
          "group": "inline"
        },
        {
          "command": "vibevideo.generateSubjects",
          "when": "view == vvResources && viewItem == subjectsRoot",
          "group": "inline"
        },
        {
          "command": "vibevideo.generateScenes",
          "when": "view == vvResources && viewItem == scenesRoot",
          "group": "inline"
        },
        {
          "command": "vibevideo.generateVideos",
          "when": "view == vvResources && viewItem == clipsRoot",
          "group": "inline"
        },
        {
          "command": "vibevideo.composeStoryboardFirstFrame",
          "when": "view == vvResources && viewItem == firstFrame",
          "group": "inline"
        },
        {
          "command": "vibevideo.generateSingleSubject",
          "when": "view == vvResources && viewItem == subject",
          "group": "inline"
        },
        {
          "command": "vibevideo.generateSingleScene",
          "when": "view == vvResources && viewItem == scene",
          "group": "inline"
        },
        {
          "command": "vibevideo.generateSingleVideo",
          "when": "view == vvResources && viewItem == clip",
          "group": "inline"
        },
        {
          "command": "vibevideo.addReferenceImage",
          "when": "view == vvResources && viewItem == referenceImagesRoot",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Vibe Video",
      "properties": {
        "vibevideo.provider": {
          "type": "string",
          "default": "tongyi-wanxiang",
          "enum": [
            "tongyi-wanxiang"
          ],
          "enumDescriptions": [
            "通义万相 - 国内服务，中文支持优秀，支持图生视频"
          ],
          "description": "视频 AI 服务商",
          "order": 1
        },
        "vibevideo.dashscope.apiKey": {
          "type": "string",
          "default": "",
          "description": "DashScope API Key（访问 https://bailian.console.aliyun.com/ 获取）",
          "markdownDescription": "DashScope API Key\n\n[点击获取 API Key](https://bailian.console.aliyun.com/)",
          "order": 2
        },
        "vibevideo.dashscope.baseUrl": {
          "type": "string",
          "default": "",
          "description": "自定义 API 基础 URL（用于本地部署模型），留空则使用阿里云 DashScope。例如：http://localhost:8000/v1/services/aigc",
          "markdownDescription": "自定义 API 基础 URL（用于本地部署模型）\n\n留空则使用阿里云 DashScope 官方服务。\n\n示例：`http://localhost:8000/v1/services/aigc`",
          "order": 3
        },
        "vibevideo.video.resolution": {
          "type": "string",
          "default": "720P",
          "enum": [
            "480P",
            "720P",
            "1080P"
          ],
          "enumDescriptions": [
            "480P - 低质量，生成快，文件小",
            "720P - 平衡质量 ⭐ 推荐",
            "1080P - 高质量，生成慢，文件大"
          ],
          "description": "视频分辨率（DashScope 官方档位）",
          "order": 4
        },
        "vibevideo.video.defaultDuration": {
          "type": "number",
          "default": 5,
          "minimum": 3,
          "maximum": 30,
          "description": "默认视频时长（秒）",
          "order": 5
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.46.3",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
