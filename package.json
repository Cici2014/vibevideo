{
  "name": "vibevideo",
  "displayName": "VibeVideo",
  "description": "Vibe Video lets you create videos like writing code: write scripts in Markdown, generate storyboards with AI, batch generate videos, and compose them with one click.",
  "version": "0.0.12",
  "publisher": "fastpen",
  "engines": {
    "vscode": "^1.99.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cici2014/vibevideo.git"
  },
  "homepage": "https://github.com/Cici2014/vibevideo",
  "bugs": {
    "url": "https://github.com/Cici2014/vibevideo/issues"
  },
  "license": "GPL-3.0 OR Commercial",
  "keywords": [
    "video",
    "ai",
    "markdown",
    "storyboard",
    "video-editing",
    "ai-video",
    "video-generation",
    "通义万相",
    "tongyi-wanxiang"
  ],
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibevideo.initProject",
        "title": "初始化项目",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.checkStoryboards",
        "title": "检查分镜质量",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.refreshResources",
        "title": "刷新资源",
        "category": "Vibe Video",
        "icon": "$(refresh)"
      },
      {
        "command": "vibevideo.showStats",
        "title": "显示项目统计",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.configureAPI",
        "title": "配置视频 AI",
        "category": "Vibe Video",
        "icon": "$(gear)"
      },
      {
        "command": "vibevideo.showConfig",
        "title": "显示当前配置",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.generateFirstFrames",
        "title": "生成所有首帧",
        "category": "Vibe Video",
        "icon": "$(file-media)"
      },
      {
        "command": "vibevideo.generateVideos",
        "title": "生成所有视频",
        "category": "Vibe Video",
        "icon": "$(play)"
      },
      {
        "command": "vibevideo.generateSingleVideo",
        "title": "生成视频",
        "category": "Vibe Video",
        "icon": "$(play)"
      },
      {
        "command": "vibevideo.generateVideoFromFirstLastFrame",
        "title": "根据首尾帧生成视频",
        "category": "Vibe Video",
        "icon": "$(play-circle)"
      },
      {
        "command": "vibevideo.generateAllVideosFromFirstLastFrame",
        "title": "根据首尾帧生成所有视频",
        "category": "Vibe Video",
        "icon": "$(play-circle)"
      },
      {
        "command": "vibevideo.generateSubjects",
        "title": "生成所有主体",
        "category": "Vibe Video",
        "icon": "$(account)"
      },
      {
        "command": "vibevideo.generateSingleSubject",
        "title": "生成主体",
        "category": "Vibe Video",
        "icon": "$(account)"
      },
      {
        "command": "vibevideo.generateScenes",
        "title": "生成所有场景",
        "category": "Vibe Video",
        "icon": "$(symbol-color)"
      },
      {
        "command": "vibevideo.generateSingleScene",
        "title": "生成场景",
        "category": "Vibe Video",
        "icon": "$(symbol-color)"
      },
      {
        "command": "vibevideo.composeFirstFrames",
        "title": "合成所有首帧",
        "category": "Vibe Video",
        "icon": "$(combine)"
      },
      {
        "command": "vibevideo.composeStoryboardFirstFrame",
        "title": "合成首帧",
        "category": "Vibe Video",
        "icon": "$(file-media)"
      },
      {
        "command": "vibevideo.openFirstFrameResource",
        "title": "打开首帧资源",
        "category": "Vibe Video"
      },
      {
        "command": "vibevideo.copyFirstFrameToNext",
        "title": "复制到下一帧",
        "category": "Vibe Video",
        "icon": "$(copy)"
      },
      {
        "command": "vibevideo.extractLastFrameToNext",
        "title": "提取最后一帧为下一分镜首帧",
        "category": "Vibe Video",
        "icon": "$(extract)"
      },
      {
        "command": "vibevideo.addReferenceImage",
        "title": "添加参考图",
        "category": "Vibe Video",
        "icon": "$(add)"
      },
      {
        "command": "vibevideo.copyRelativePath",
        "title": "复制相对路径",
        "category": "Vibe Video",
        "icon": "$(copy)"
      },
      {
        "command": "vibevideo.renameResource",
        "title": "重命名",
        "category": "Vibe Video",
        "icon": "$(edit)"
      },
      {
        "command": "vibevideo.revealInExplorer",
        "title": "在资源管理器中打开",
        "category": "Vibe Video",
        "icon": "$(file-directory)"
      },
      {
        "command": "vibevideo.deleteResource",
        "title": "删除",
        "category": "Vibe Video",
        "icon": "$(trash)"
      },
      {
        "command": "vibevideo.deselectImage",
        "title": "不选中",
        "category": "Vibe Video",
        "icon": "$(circle-outline)"
      },
      {
        "command": "vibevideo.selectImage",
        "title": "选中",
        "category": "Vibe Video",
        "icon": "$(check)"
      },
      {
        "command": "vibevideo.editImage",
        "title": "图像编辑",
        "category": "Vibe Video",
        "icon": "$(edit)"
      },
      {
        "command": "vibevideo.composeVideo",
        "title": "视频合成",
        "category": "Vibe Video",
        "icon": "$(combine)"
      },
      {
        "command": "vibevideo.copyImage",
        "title": "复制",
        "category": "Vibe Video",
        "icon": "$(copy)"
      },
      {
        "command": "vibevideo.pasteImage",
        "title": "粘贴",
        "category": "Vibe Video",
        "icon": "$(paste)"
      },
      {
        "command": "vibevideo.deselectVideo",
        "title": "不选中",
        "category": "Vibe Video",
        "icon": "$(circle-outline)"
      },
      {
        "command": "vibevideo.selectVideo",
        "title": "选中",
        "category": "Vibe Video",
        "icon": "$(check)"
      }
